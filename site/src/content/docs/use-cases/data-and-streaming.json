iki-light:#D73A49;--shiki-dark:#F47067\">.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">truncate</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">(</span><span style=\"--shiki-light:#032F62;--shiki-dark:#96D0FF\">\"1d\"</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">)</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">alias</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">(</span><span style=\"--shiki-light:#032F62;--shiki-dark:#96D0FF\">\"day\"</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">),</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">        ])</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">        .</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">group_by</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">([</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">col</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">(</span><span style=\"--shiki-light:#032F62;--shiki-dark:#96D0FF\">\"day\"</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">), </span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">col</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">(</span><span style=\"--shiki-light:#032F62;--shiki-dark:#96D0FF\">\"currency\"</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">)])</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">        .</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">agg</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">([</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">            col</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">(</span><span style=\"--shiki-light:#032F62;--shiki-dark:#96D0FF\">\"amount\"</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">)</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">sum</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">()</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">alias</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">(</span><span style=\"--shiki-light:#032F62;--shiki-dark:#96D0FF\">\"gross\"</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">),</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">            col</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">(</span><span style=\"--shiki-light:#032F62;--shiki-dark:#96D0FF\">\"order_id\"</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">)</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">count</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">()</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">alias</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">(</span><span style=\"--shiki-light:#032F62;--shiki-dark:#96D0FF\">\"orders\"</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">),</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">        ])</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">        .</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">sort</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">([</span><span style=\"--shiki-light:#032F62;--shiki-dark:#96D0FF\">\"day\"</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">], </span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#F69D50\">SortMultipleOptions</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">::</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">default</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">())</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">        .</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">collect</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">()</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">}</span></span></code></pre></figure>\n<p>Three things the lazy engine does that a naive loop does not:</p>\n<ol>\n<li><strong>Predicate pushdown</strong> — the <code>status = 'paid'</code> filter is applied while reading\nrow groups, so rejected rows are never decompressed.</li>\n<li><strong>Projection pushdown</strong> — only the five columns referenced are read.</li>\n<li><strong>Vectorised aggregation</strong> — hash-grouped in parallel across cores.</li>\n</ol>\n<p>On a wide table this is routinely a 10–50× difference in wall time.</p>\n<h2 id=\"reading-arrow-directly\">Reading Arrow directly</h2>\n<p>When you are writing the engine rather than using one:</p>\n<figure data-rehype-pretty-code-figure=\"\"><pre tabindex=\"0\" data-language=\"rust\" data-theme=\"github-light github-dark-dimmed\"><code data-language=\"rust\" data-theme=\"github-light github-dark-dimmed\" style=\"display: grid;\"><span data-line=\"\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">use</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#F69D50\"> arrow</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">::</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#F69D50\">array</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">::</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">{</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#F69D50\">Int64Array</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">, </span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#F69D50\">StringArray</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">};</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">use</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#F69D50\"> arrow</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">::</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#F69D50\">compute</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">::</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">filter;</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">use</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#F69D50\"> arrow</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">::</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#F69D50\">record_batch</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">::</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#F69D50\">RecordBatch</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">;</span></span>\n<span data-line=\"\"> </span>\n<span data-line=\"\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">fn</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\"> filter_paid</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">(batch</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">:</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\"> &#x26;</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#F69D50\">RecordBatch</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">) </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">-></span><span style=\"--shiki-light:#6F42C1;--shiki-dark:
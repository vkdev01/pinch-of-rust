/span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">(</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">||</span><span style=\"--shiki-light:#032F62;--shiki-dark:#96D0FF\"> \".\"</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">into</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">());</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">    let</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\"> count </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">=</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#F69D50\"> AtomicUsize</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">::</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">new</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">(</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#6CB6FF\">0</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">);</span></span>\n<span data-line=\"\"> </span>\n<span data-line=\"\"><span style=\"--shiki-light:#6F42C1;--shiki-dark:#F69D50\">    WalkBuilder</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">::</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">new</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">(</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">&#x26;</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">root)</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">        .</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">standard_filters</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">(</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#6CB6FF\">true</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">)      </span><span style=\"--shiki-light:#6A737D;--shiki-dark:#768390\">// .gitignore, hidden files, symlinks</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">        .</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">threads</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">(</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">num_cpus</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">())         </span><span style=\"--shiki-light:#6A737D;--shiki-dark:#768390\">// parallel directory traversal</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">        .</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">build_parallel</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">()</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">        .</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">run</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">(</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">||</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\"> {</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#6F42C1;--shiki-dark:#F69D50\">            Box</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">::</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#DCBDFB\">new</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">(</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">|</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\">entry</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">|</span><span style=\"--shiki-light:#24292E;--shiki-dark:#ADBAC7\"> {</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\">                if</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F47067\"> let</span><span style=\"--shiki-light:#6F42C1